# Copy to .env.local and fill in from the `make deploy` outputs (KycAuth, KycApi). Gitignored.
# `npm run dev` reads it automatically (Vite convention).
VITE_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# The identity pool lets the browser stream the face check straight to Amazon Rekognition.
VITE_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# The KycApi ApiUrl output, without a trailing slash.
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
